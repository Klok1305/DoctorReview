{
  "name": "doctor-performance-app",
  "version": "2.6.12",
  "description": "Административное приложение «КлинВект Щербатова» для аналитики врачей и отделений",
  "main": "desktop/main.cjs",
  "author": "Nikita",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Klok1305/DoctorReview.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "assemble": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./build/assemble.ps1",
    "audit:repo": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/audit-repository.ps1",
    "start": "pnpm run assemble && electron .",
    "start:viewer": "electron ./viewer",
    "start:mobile-pilot": "node ./scripts/serve-mobile-pilot.cjs",
    "start:mobile-pilot:lan": "node ./scripts/serve-mobile-pilot.cjs --lan",
    "start:mobile-server:local": "node ./mobile-server/server.cjs --local",
    "build:mobile-server": "node ./scripts/build-mobile-server-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "pnpm run assemble && electron . --smoke-test",
    "test:pdf": "pnpm run assemble && electron . --pdf-smoke",
    "dist": "pnpm run assemble && electron-builder --win nsis --publish never",
    "dist:viewer": "electron-builder --config electron-builder.viewer.json --win nsis --publish never",
    "dist:all": "pnpm run dist && pnpm run dist:viewer"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.local.doctorperformance",
    "productName": "КлинВект Щербатова — Администратор",
    "artifactName": "KlinVekt-Shcherbatova-Admin-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "electronLanguages": ["ru", "en-US"],
    "files": [
      "index.html",
      "build/app.css",
      "build/jszip.min.js",
      "desktop/**",
      "viewer/standalone.html",
      "viewer/standalone-app.js",
      "viewer/viewer.css",
      "resources/**",
      "docs/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Klok1305",
        "repo": "DoctorReview",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "КлинВект Щербатова — Администратор",
      "deleteAppDataOnUninstall": false
    }
  }
}
